{
  "name": "{{npm_name}}",
  "version": "{{version}}",
  "description": "Crawlora {{display_name}} API client with {{operation_count}} endpoints for {{seo_summary}}",
  "homepage": "{{homepage}}",
  "bugs": { "url": "{{bugs_url}}" },
  "keywords": {{seo_keywords_json}},
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "{{repository}}",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
