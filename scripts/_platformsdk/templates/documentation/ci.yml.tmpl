name: CI

on:
  push:
    branches: ["main"]
  pull_request:
  workflow_dispatch:
  workflow_call:
    inputs:
      ref:
        description: Git revision to validate
        required: false
        type: string
      candidate_artifact:
        description: Source artifact produced by sync-contract.yml
        required: false
        type: string

permissions:
  contents: read

jobs:
  javascript:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node: [18, 22]
    defaults:
      run:
        working-directory: javascript
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
          cache: npm
          cache-dependency-path: javascript/package-lock.json
      - run: npm ci
      - run: npm test
      - run: npm run typecheck
      - run: npm pack --dry-run

  python:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python: ["3.10", "3.12"]
    defaults:
      run:
        working-directory: python
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
          cache: pip
          cache-dependency-path: python/pyproject.toml
      - run: python -m pip install -e ".[test]"
      - run: python -m pytest

  go:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - run: go test ./...
      - run: go vet ./...

  ruby:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: "3.2"
      - run: ruby -Ilib test/test_client.rb
        working-directory: ruby
      - run: gem build ./*.gemspec --output "$RUNNER_TEMP/crawlora-platform.gem"
        working-directory: ruby

  java:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven
          cache-dependency-path: java/pom.xml
      - run: mvn --batch-mode test
        working-directory: java

  php:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: shivammathur/setup-php@v2
        with:
          php-version: "8.2"
          tools: composer:v2
      - run: composer validate --no-check-publish
        working-directory: php
      - run: composer test
        working-directory: php

  generated-contract-and-artifacts:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref || github.sha }}
      - name: Download generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.candidate_artifact }}
          path: ${{ runner.temp }}/candidate
      - name: Apply generated candidate
        if: ${{ inputs.candidate_artifact != '' }}
        run: |
          mkdir -p "${{ runner.temp }}/candidate/tree"
          tar -xzf "${{ runner.temp }}/candidate/source.tar.gz" -C "${{ runner.temp }}/candidate/tree"
          rsync -a --delete --exclude=.git "${{ runner.temp }}/candidate/tree/" "$GITHUB_WORKSPACE/"
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Capture candidate before regeneration
        run: |
          git add -A
          git diff --cached --binary > "$RUNNER_TEMP/before-generation.patch"
      - run: python -m unittest discover -s scripts -p 'test_*sync.py'
      - run: python scripts/generate.py
      - name: Verify regeneration preserved the candidate snapshot
        run: |
          git add -A
          git diff --cached --binary > "$RUNNER_TEMP/after-generation.patch"
          cmp "$RUNNER_TEMP/before-generation.patch" "$RUNNER_TEMP/after-generation.patch"
      - run: npm pack --pack-destination "$RUNNER_TEMP" --json
        working-directory: javascript
      - run: python -m pip install build
      - run: python -m build --outdir "$RUNNER_TEMP/python-dist"
        working-directory: python
      - run: go test ./...
      - run: ruby -Ilib test/test_client.rb
        working-directory: ruby
      - run: mvn --batch-mode test
        working-directory: java
      - run: composer validate --no-check-publish && composer test
        working-directory: php
