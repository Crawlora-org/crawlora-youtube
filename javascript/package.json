{
  "name": "@crawlora-org/youtube",
  "version": "0.1.9",
  "description": "Crawlora YouTube API client with 14 endpoints for search, channels, videos, playlists, comments, captions, and transcripts",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=youtube-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-youtube/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "youtube", "youtube-api", "youtube-scraper", "youtube-data", "youtube-search", "youtube-channels", "youtube-videos", "youtube-playlists", "youtube-comments", "youtube-captions", "youtube-transcripts"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-youtube",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
