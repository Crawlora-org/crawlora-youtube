{
  "name": "crawlora/youtube",
  "description": "Crawlora YouTube API client with 14 endpoints for search, channels, videos, playlists, comments, captions, and transcripts",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "youtube",
    "youtube-api",
    "youtube-scraper",
    "youtube-data",
    "youtube-search",
    "youtube-channels",
    "youtube-videos",
    "youtube-playlists",
    "youtube-comments",
    "youtube-captions",
    "youtube-transcripts"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Youtube\\": "src/Crawlora/Youtube/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Youtube\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=youtube-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-youtube",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=youtube-php-api-docs"
  }
}
